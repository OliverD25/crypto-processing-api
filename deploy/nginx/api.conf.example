# nginx site for the platform API, to be included by btcpayserver-docker's nginx.
#
# Install:
#   sudo cp api.conf.example \
#     /etc/nginx/conf.d/crypto-processing-api.conf   # or the btcpayserver-docker
#                                                    # custom include directory
#   sudo nginx -t && sudo systemctl reload nginx
#
# btcpayserver-docker runs its own nginx with letsencrypt-nginx-proxy-companion.
# The simplest arrangement is to let that container handle TLS by setting
# VIRTUAL_HOST / LETSENCRYPT_HOST on the api service. This file is the manual
# alternative for a plain host nginx.

# Cloudflare's origin-facing ranges. Without this, every request appears to
# come from Cloudflare and the access log is useless for tracing anything.
#
# Refresh from https://www.cloudflare.com/ips/ — the list does change:
#   for ip in $(curl -s https://www.cloudflare.com/ips-v4); do \
#     echo "set_real_ip_from $ip;"; done
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;

# Trust this header only from the ranges above. Trusting it from anywhere would
# let a caller who reaches the origin directly forge their own source IP.
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# A brute-force zone is close to pointless against 256-bit keys, but it caps
# what a broken client can do to the database.
limit_req_zone $binary_remote_addr zone=cpapi:10m rate=20r/s;

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    ssl_certificate     /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    access_log /var/log/nginx/crypto-api.access.log;
    error_log  /var/log/nginx/crypto-api.error.log warn;

    # Balances and withdrawal states must never be served from a cache. The
    # application sets this too; belt and braces, because a stale balance is a
    # support ticket at best.
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    client_max_body_size 256k;

    location / {
        limit_req zone=cpapi burst=40 nodelay;

        proxy_pass http://crypto-api:8000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Greenfield can be slow on a cold NBXplorer query and a deposit
        # creation waits on it.
        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    # The uptime pinger's target: process and database only, so a BTCPay
    # restart does not page anyone.
    location = /healthz {
        proxy_pass http://crypto-api:8000/healthz;
        access_log off;
    }

    # Component detail. Not secret, but not something to advertise either —
    # uncomment to restrict it to your own address.
    location = /readyz {
        # allow 203.0.113.7;
        # deny all;
        proxy_pass http://crypto-api:8000/readyz;
        access_log off;
    }

    # The BTCPay webhook path does not need to be reachable from the internet
    # at all on a single-box deployment: BTCPay posts to the container name
    # over the Docker network. Leave this blocked unless BTCPay is on another
    # host, in which case delete the block and keep the HMAC (which is on
    # regardless).
    location = /webhooks/btcpay {
        deny all;
    }
}
