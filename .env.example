# crypto-processing-api — configuration reference
#
# Copy to .env and edit. Every variable the service reads is listed here with its
# default. Environment variables win over the .env file. `chmod 600 .env`.
#
#   cp .env.example .env
#
# Nothing in this file is a secret; nothing in .env may ever be committed
# (.gitignore blocks it, gitleaks checks it, and a public crypto repo is scanned
# by credential bots within minutes).

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

# development | test | staging | production.
# Also selects the API key prefix: development/test mint cpk_test_ keys,
# everything else mints cpk_live_ keys.
ENVIRONMENT=development

# Verbose errors and reload behaviour. The service REFUSES TO START with
# DEBUG=true unless ENVIRONMENT=development.
DEBUG=false

# Python logging level for the structlog pipeline: DEBUG|INFO|WARNING|ERROR.
LOG_LEVEL=INFO

# true = one JSON object per line (ship to a log collector).
# false = human-readable console output for local work.
LOG_JSON=true

# ---------------------------------------------------------------------------
# Database (the ledger — never share this instance with BTCPay's Postgres)
# ---------------------------------------------------------------------------

# Required. postgresql:// or postgresql+psycopg:// (psycopg 3 only).
DATABASE_URL=postgresql://cpapi:cpapi@localhost:54329/cpapi

# Connection pool. Postgres connections are the scarce resource on a 4GB box
# shared with BTCPay and bitcoind — keep these small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Echo every SQL statement. Debugging only; extremely noisy.
DB_ECHO=false

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Bind address inside the container. The API publishes no ports in production:
# BTCPay and the platform reach it over the internal Docker network.
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Idempotency-Key handling
# ---------------------------------------------------------------------------

# An in_progress idempotency row older than this many seconds may be reclaimed
# by a retry. Protects against a crash between "row inserted" and "work done"
# turning into an infinite 409 loop on a money endpoint.
IDEMPOTENCY_STALE_SECONDS=60

# How long completed idempotency records are retained before the purge job
# removes them.
IDEMPOTENCY_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Asset seed values
#
# These are read ONCE, by `python -m crypto_processing_api.cli migrate`, to
# insert the `assets` rows. After that the DATABASE ROW IS THE ONLY SOURCE OF
# TRUTH — editing these variables later changes nothing. Change limits with SQL
# (or a future admin endpoint), not here.
# ---------------------------------------------------------------------------

# BTC — amounts in satoshis (8 decimals).

# BTCPay payment method id for BTC. Version-dependent string; the deposit code
# discovers and caches the real value from the store at startup.
SEED_BTC_PAYMENT_METHOD=BTC-CHAIN

# Withdrawals at or below this gross amount auto-approve. Above it they queue
# for admin approval. 500000 sat = 0.005 BTC.
SEED_BTC_WITHDRAWAL_AUTO_LIMIT=500000

# Rolling 24h per-asset withdrawal cap. Once the window sum reaches this, every
# withdrawal goes to manual approval regardless of size. This is the control
# that actually bounds a drained-API-key attack. 5000000 sat = 0.05 BTC.
SEED_BTC_WITHDRAWAL_DAILY_CAP=5000000

# Optional rolling 24h cap per user. Empty = disabled.
SEED_BTC_WITHDRAWAL_USER_DAILY_CAP=

# Smallest accepted gross withdrawal, in satoshis. The dust rule (net > 546 sat)
# applies on top of this.
SEED_BTC_WITHDRAWAL_MIN=1

# Flat service fee added by us on top of the network fee estimate. 0 = the user
# pays only the estimated miner fee.
SEED_BTC_WITHDRAWAL_FLAT_FEE=0

# USDT-TRC20 — amounts in micro-USDT (6 decimals).

# BTCPay payment method id exposed by the USDt plugin. Version-dependent;
# discovered from the store at startup like the BTC one.
SEED_USDT_PAYMENT_METHOD=USDT_TRC20

# 200000000 micro-USDT = 200 USDT. Note USDT withdrawals are manual-only in the
# MVP (USDT_AUTO_WITHDRAW below), so this limit only takes effect in Phase 2.
SEED_USDT_WITHDRAWAL_AUTO_LIMIT=200000000

# 2000000000 micro-USDT = 2000 USDT.
SEED_USDT_WITHDRAWAL_DAILY_CAP=2000000000

# Optional rolling 24h cap per user. Empty = disabled.
SEED_USDT_WITHDRAWAL_USER_DAILY_CAP=

# Smallest accepted gross withdrawal, in micro-USDT.
SEED_USDT_WITHDRAWAL_MIN=1

# Flat USDT withdrawal fee covering the operator's TRX gas.
# 1000000 micro-USDT = 1 USDT.
SEED_USDT_WITHDRAWAL_FLAT_FEE=1000000

# ---------------------------------------------------------------------------
# Withdrawal policy (used from M3 on)
# ---------------------------------------------------------------------------

# deduct = the user receives gross - fee (default).
# absorb = the user receives gross and the operator eats the fee.
WITHDRAWAL_FEE_MODE=deduct

# The BTCPay USDt plugin has no payout handler, so automated USDT sending does
# not exist in the MVP. Leave false until the Phase-2 TRON sender ships.
USDT_AUTO_WITHDRAW=false

# ---------------------------------------------------------------------------
# Deposits (used from M2 on)
# ---------------------------------------------------------------------------

# Invoice checkout window in minutes. USDT is NOT shortened to recycle the TRON
# address pool: a short window makes late payments land on another user's
# reserved address. Size the pool up instead.
DEPOSIT_INVOICE_EXPIRY_MIN_BTC=60
DEPOSIT_INVOICE_EXPIRY_MIN_USDT=60

# ---------------------------------------------------------------------------
# BTCPay Server (used from M2 on; the regtest bootstrap script writes these
# values to .env.regtest.generated for you)
# ---------------------------------------------------------------------------

# Greenfield base URL. Container-to-container inside the Docker network.
BTCPAY_URL=http://btcpayserver:49392

# Restricted Greenfield API key scoped to the single store. Never server-admin.
BTCPAY_API_KEY=

# The store this service owns.
BTCPAY_STORE_ID=

# Webhook signing secret. MUST be different from BTCPAY_API_KEY — the webhook
# path verifies HMAC over raw bytes with this value.
BTCPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# TRON / TronGrid (used from M4 on)
# ---------------------------------------------------------------------------

# TronGrid API key. Free tier is 100K requests/day at 15 QPS. Keyless access is
# throttled unpredictably, so the deployment docs treat this as mandatory.
TRONGRID_API_KEY=
