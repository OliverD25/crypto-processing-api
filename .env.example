# crypto-processing-api — configuration reference
#
# Copy to .env and edit. Every variable the service reads is listed here with its
# default. Environment variables win over the .env file. `chmod 600 .env`.
#
#   cp .env.example .env
#
# Nothing in this file is a secret; nothing in .env may ever be committed
# (.gitignore blocks it, gitleaks checks it, and a public crypto repo is scanned
# by credential bots within minutes).

# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------

# development | test | staging | production.
# Also selects the API key prefix: development/test mint cpk_test_ keys,
# everything else mints cpk_live_ keys.
ENVIRONMENT=development

# Verbose errors and reload behaviour. The service REFUSES TO START with
# DEBUG=true unless ENVIRONMENT=development.
DEBUG=false

# Python logging level for the structlog pipeline: DEBUG|INFO|WARNING|ERROR.
LOG_LEVEL=INFO

# true = one JSON object per line (ship to a log collector).
# false = human-readable console output for local work.
LOG_JSON=true

# ---------------------------------------------------------------------------
# Database (the ledger — never share this instance with BTCPay's Postgres)
# ---------------------------------------------------------------------------

# Required. postgresql:// or postgresql+psycopg:// (psycopg 3 only).
DATABASE_URL=postgresql://cpapi:cpapi@localhost:54329/cpapi

# Connection pool. Postgres connections are the scarce resource on a 4GB box
# shared with BTCPay and bitcoind — keep these small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Echo every SQL statement. Debugging only; extremely noisy.
DB_ECHO=false

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# Bind address inside the container. The API publishes no ports in production:
# BTCPay and the platform reach it over the internal Docker network.
API_HOST=0.0.0.0
API_PORT=8000

# ---------------------------------------------------------------------------
# Idempotency-Key handling
# ---------------------------------------------------------------------------

# An in_progress idempotency row older than this many seconds may be reclaimed
# by a retry. Protects against a crash between "row inserted" and "work done"
# turning into an infinite 409 loop on a money endpoint.
IDEMPOTENCY_STALE_SECONDS=60

# How long completed idempotency records are retained before the purge job
# removes them.
IDEMPOTENCY_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Asset seed values
#
# These are read ONCE, by `python -m crypto_processing_api.cli migrate`, to
# insert the `assets` rows. After that the DATABASE ROW IS THE ONLY SOURCE OF
# TRUTH — editing these variables later changes nothing. Change limits with SQL
# (or a future admin endpoint), not here.
# ---------------------------------------------------------------------------

# BTC — amounts in satoshis (8 decimals).

# BTCPay payment method id for BTC. Version-dependent string; the deposit code
# discovers and caches the real value from the store at startup.
SEED_BTC_PAYMENT_METHOD=BTC-CHAIN

# Withdrawals at or below this gross amount auto-approve. Above it they queue
# for admin approval. 500000 sat = 0.005 BTC.
SEED_BTC_WITHDRAWAL_AUTO_LIMIT=500000

# Rolling 24h per-asset withdrawal cap. Once the window sum reaches this, every
# withdrawal goes to manual approval regardless of size. This is the control
# that actually bounds a drained-API-key attack. 5000000 sat = 0.05 BTC.
SEED_BTC_WITHDRAWAL_DAILY_CAP=5000000

# Optional rolling 24h cap per user. Empty = disabled.
SEED_BTC_WITHDRAWAL_USER_DAILY_CAP=

# Smallest accepted gross withdrawal, in satoshis. The dust rule (net > 546 sat)
# applies on top of this.
SEED_BTC_WITHDRAWAL_MIN=1

# Flat service fee added by us on top of the network fee estimate. 0 = the user
# pays only the estimated miner fee.
SEED_BTC_WITHDRAWAL_FLAT_FEE=0

# USDT-TRC20 — amounts in micro-USDT (6 decimals).

# BTCPay payment method id exposed by the USDt plugin. Version-dependent;
# discovered from the store at startup like the BTC one.
SEED_USDT_PAYMENT_METHOD=USDT_TRC20

# 200000000 micro-USDT = 200 USDT. Note USDT withdrawals are manual-only in the
# MVP (USDT_AUTO_WITHDRAW below), so this limit only takes effect in Phase 2.
SEED_USDT_WITHDRAWAL_AUTO_LIMIT=200000000

# 2000000000 micro-USDT = 2000 USDT.
SEED_USDT_WITHDRAWAL_DAILY_CAP=2000000000

# Optional rolling 24h cap per user. Empty = disabled.
SEED_USDT_WITHDRAWAL_USER_DAILY_CAP=

# Smallest accepted gross withdrawal, in micro-USDT.
SEED_USDT_WITHDRAWAL_MIN=1

# Flat USDT withdrawal fee covering the operator's TRX gas.
# 1000000 micro-USDT = 1 USDT.
SEED_USDT_WITHDRAWAL_FLAT_FEE=1000000

# ---------------------------------------------------------------------------
# Lightning (BTC_LN) — off by default, and the default is a security decision
# ---------------------------------------------------------------------------
#
# Turning this on has two consequences worth reading before you do:
#
# 1. The bootstrap asks BTCPay for `btcpay.server.canuseinternallightningnode`,
#    a SERVER-level permission. Every other scope this service holds is pinned
#    to one store. That widening is the price of enabling BTC-LN through the
#    API instead of clicking it in the UI, and docs/operating/security.md threat 5 says
#    what it means. Left false, the scope list is byte-identical to a
#    deployment that has never heard of Lightning.
#
# 2. BTC_LN is a SEPARATE asset with its own accounts and its own float —
#    channel balance, not wallet balance. Users get a second, non-fungible BTC
#    balance: Lightning funds cannot be withdrawn on chain or the reverse.
#    Moving value between the two is an operator job, see
#    docs/operating/runbook-ln-rebalance.md.
#
# Switching it back off after the row exists is refused at startup. An asset
# holding user balances must not vanish because an environment variable did.
LIGHTNING_ENABLED=false

# BTCPay's Lightning payment method id. `BTC-LN` on 2.4.2.
SEED_LN_PAYMENT_METHOD=BTC-LN

# Amounts in satoshis, exactly like the BTC ones — but bounding a different
# pot of money. The BTC caps say nothing about how much can leave the channel.
SEED_LN_WITHDRAWAL_AUTO_LIMIT=200000
SEED_LN_WITHDRAWAL_DAILY_CAP=2000000
SEED_LN_WITHDRAWAL_USER_DAILY_CAP=

# Must stay above the flat fee, or the smallest accepted withdrawal delivers
# nothing and is refused as dust a moment later.
SEED_LN_WITHDRAWAL_MIN=1000

# A flat service charge, not an estimate. A routing fee cannot be known before
# the route is found; what it actually cost is read from the node afterwards
# and booked to network_fee_expense, so this number is revenue.
SEED_LN_WITHDRAWAL_FLAT_FEE=100

# How long a Lightning payout may sit unpaid before this service cancels it.
# BTCPay's Lightning processor retries an unroutable payout for as long as the
# invoice lives and never marks it failed, so without this the withdrawal stays
# `submitted` forever with the user's balance held.
LN_PAYOUT_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Withdrawal policy (used from M3 on)
# ---------------------------------------------------------------------------

# deduct = the user receives gross - fee (default).
# absorb = the user receives gross and the operator eats the fee.
WITHDRAWAL_FEE_MODE=deduct

# The BTCPay USDt plugin has no payout handler, so automated USDT sending does
# not exist yet. Setting this to true is REFUSED AT STARTUP: an auto-approved
# USDT withdrawal has no code path that can send it, so the request would stall
# with the user's balance held. Leave it false until a TRON signer ships.
USDT_AUTO_WITHDRAW=false

# ---------------------------------------------------------------------------
# Deposits (used from M2 on)
# ---------------------------------------------------------------------------

# Invoice checkout window in minutes. USDT is NOT shortened to recycle the TRON
# address pool: a short window makes late payments land on another user's
# reserved address. Size the pool up instead.
DEPOSIT_INVOICE_EXPIRY_MIN_BTC=60
DEPOSIT_INVOICE_EXPIRY_MIN_USDT=60

# Lightning is shorter on purpose: an open BOLT11 invoice ties up inbound
# channel liquidity for as long as it lives, and a payer who has not acted in
# half an hour is not about to.
DEPOSIT_INVOICE_EXPIRY_MIN_LN=30

# How long after expiry BTCPay keeps attributing payments to an invoice.
# Beyond this window a payment to that address is credited to no invoice at all
# and only the wallet scan below can find it, so the deposit sweep stops
# polling here. Must be at least the invoice expiry.
DEPOSIT_MONITORING_MINUTES=1440

# ---------------------------------------------------------------------------
# Worker schedule (the reconciliation loop; used from M2 on)
#
# Webhooks only reduce latency. These jobs are what make deposits correct:
# BTCPay gives up redelivering after roughly eight tries in an hour, so an
# outage longer than that is recovered here or not at all.
# ---------------------------------------------------------------------------

# How often the worker drains the webhook_events queue.
WEBHOOK_POLL_INTERVAL_SECONDS=5

# Attempts before a webhook event is parked as failed for an operator.
WEBHOOK_MAX_ATTEMPTS=10

# Job A: re-ask BTCPay about every deposit still worth asking about.
RECONCILE_DEPOSIT_INTERVAL_SECONDS=120

# Fallback window for polling settled and expired deposits when BTCPay did not
# report a monitoring expiry. Deposit addresses keep working, and users reuse
# them.
RECONCILE_SETTLED_WINDOW_DAYS=7

# Nightly page-through of the store's invoices, looking for ours that have no
# local row — the case after restoring a database from an older backup.
RECONCILE_ORPHAN_SCAN_INTERVAL_SECONDS=86400

# Wallet scan: flags coins that arrived in the hot wallet with no matching
# deposit payment. The only detector for a payment to an address BTCPay has
# stopped watching.
WALLET_SCAN_INTERVAL_SECONDS=600

# ---------------------------------------------------------------------------
# BTCPay Server (used from M2 on; the regtest bootstrap script writes these
# values to .env.regtest.generated for you)
# ---------------------------------------------------------------------------

# Greenfield base URL. Container-to-container inside the Docker network.
BTCPAY_URL=http://btcpayserver:49392

# Restricted Greenfield API key scoped to the single store. Never server-admin.
BTCPAY_API_KEY=

# The store this service owns.
BTCPAY_STORE_ID=

# Webhook signing secret. MUST be different from BTCPAY_API_KEY — the webhook
# path verifies HMAC over raw bytes with this value.
BTCPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Withdrawals — BTC (used from M3 on)
# ---------------------------------------------------------------------------

# Which Bitcoin network destination addresses are validated against. Getting
# this wrong means accepting an address that no node on your chain can pay.
# The service refuses to start in production with anything but mainnet.
BITCOIN_NETWORK=mainnet

# Confirmation target for the fee estimate, in blocks.
BTC_FEE_TARGET_BLOCKS=3

# Assumed transaction size for pricing a payout, in virtual bytes.
#
# Raise this if your hot wallet holds many small deposit UTXOs, which is what a
# custodial deposit wallet naturally becomes. Each extra P2WPKH input adds
# roughly 68 vB, so a payout spending eight inputs runs past 600 vB. Charging
# for less than the real size is a loss on every withdrawal that grows with
# volume; charging for more leaves the surplus in the hot wallet, which is the
# safe direction.
BTC_PAYOUT_VSIZE_VB=300

# Used only when BTCPay and mempool.space both fail to answer. Reaching this
# logs an error, because every withdrawal is then priced off a guess.
BTC_FALLBACK_FEE_SAT_PER_VB=20

# Withdrawals whose net amount lands at or below this are refused before any
# hold is placed. Below the dust limit the output is unspendable.
BTC_DUST_THRESHOLD_SAT=546

# Second fee source, tried when BTCPay's wallet estimate is unavailable.
# Empty disables it, which is the right choice for a deployment that must not
# make outbound calls to third parties.
MEMPOOL_SPACE_URL=https://mempool.space/api/v1/fees/recommended

# How often approved withdrawals are turned into BTCPay payouts.
WITHDRAWAL_SUBMIT_INTERVAL_SECONDS=10

# Job B: how often submitted and broadcast payouts are re-checked.
RECONCILE_WITHDRAWAL_INTERVAL_SECONDS=60

# How long a withdrawal may sit in `submitting` with no payout reference
# before reconciliation tries to work out what happened to it.
STUCK_SUBMITTING_SECONDS=300

# ---------------------------------------------------------------------------
# TRON / USDT-TRC20 (used from M4 on)
#
# USDT withdrawals are sent by a human: the BTCPay USDt plugin has no payout
# handler of any kind. These settings are what verifies the operator's work.
# ---------------------------------------------------------------------------

# mainnet | nile. Selects the default TronGrid endpoint and USDT contract.
TRON_NETWORK=mainnet

# Override the endpoint if you run your own node or a paid provider.
# Empty uses https://api.trongrid.io (mainnet) or https://nile.trongrid.io.
TRONGRID_BASE_URL=

# Required once TRON_HOT_WALLET_ADDRESS is set — the service refuses to start
# in production without it. Free tier is 100K requests/day at 15 QPS; keyless
# access is throttled unpredictably, and what gets throttled is the check that
# a withdrawal really happened.
TRONGRID_API_KEY=

# The USDT-TRC20 contract. Must match what the USDt plugin is configured with:
# BTCPay watches for transfers of that token and the withdrawal verifier
# refuses transfers of any other one.
# Empty uses TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t on mainnet. The Nile default is
# format-checked only, not confirmed against a live node — set it explicitly.
USDT_CONTRACT_ADDRESS=

# The TRON address USDT is sent FROM. Verification compares every transfer's
# sender against this, so a wrong value rejects every genuine withdrawal.
# Leaving it empty disables the TRON jobs entirely, which is correct for a
# BTC-only deployment.
TRON_HOT_WALLET_ADDRESS=

# Blocks before a manual withdrawal is treated as final. 19 is roughly TRON's
# solidified-block distance.
TRON_CONFIRMATIONS=19

# How far a settled USDT deposit may deviate from the expected amount before it
# goes to review instead of crediting. Pooled addresses mean attribution is
# heuristic; this catches most cross-attribution. Only applies when the platform
# supplied an expected amount. 0 disables it.
USDT_AMOUNT_TOLERANCE_PCT=1.0

# TRC-20 transfers cost TRX, not USDT. A wallet full of USDT and empty of TRX
# cannot send anything, and the symptom looks like "withdrawals are broken".
TRX_ALERT_THRESHOLD=200
GAS_MONITOR_INTERVAL_SECONDS=900

# ---------------------------------------------------------------------------
# Alerts
# ---------------------------------------------------------------------------

# Optional ntfy.sh (or compatible) topic URL. Alerts are always logged; this
# adds a push. Full alert routing arrives in M5.
NTFY_TOPIC_URL=

# Optional Telegram bot. BOTH must be set or the transport stays off — a token
# with no chat id has nowhere to send. Alerts still reach the log either way.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Outbound webhooks to the platform
#
# Optional. A polling-only integration is a legitimate deployment: with these
# unset, events are queued and never sent, and turning delivery on later ships
# the backlog rather than losing it.
#
# These are NOTIFICATIONS, NOT TRUTH. The platform must still be able to
# re-read GET /v1/deposits/{id} and GET /v1/users/{id}/balances. Every
# integration that treats a webhook as authoritative eventually double-credits
# something. The payload schema is docs/reference/webhook-events.json.
# ---------------------------------------------------------------------------

# Where deposit and withdrawal events are POSTed. Empty disables delivery.
PLATFORM_WEBHOOK_URL=

# HMAC-SHA256 key for the X-CPA-Signature header. The service REFUSES TO
# START if PLATFORM_WEBHOOK_URL is set and this is not: an unsigned webhook is
# one anybody can forge.
PLATFORM_WEBHOOK_SECRET=

# How often the delivery worker drains the queue. The per-event retry schedule
# is fixed in code (1m, 5m, 30m, 2h, 6h, then 12h to roughly three days, ten
# attempts) and is not configurable — a dead-lettered event is parked with its
# error and re-queued by hand, never dropped.
OUTBOUND_DELIVERY_INTERVAL_SECONDS=15

# Per-request timeout for one delivery attempt.
OUTBOUND_HTTP_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Reconciliation and health (Job C, and what /readyz reports)
# ---------------------------------------------------------------------------

# Job C: how often the books are re-derived from the postings and custody is
# compared against the chain. This is the job that would notice an insolvency,
# so lengthening it lengthens how long one can go unnoticed.
RECONCILE_INVARIANT_INTERVAL_SECONDS=3600

# A worker job whose last run is older than this reads as stale in /readyz.
# /healthz is process-and-database only, so a dead worker cannot make the API
# look down — this is how a dead worker is noticed instead.
WORKER_HEARTBEAT_STALE_SECONDS=300

# Failed webhook signature verifications in the last hour before an alert is
# raised. A spike means either a misconfigured secret or someone probing the
# ingress endpoint.
WEBHOOK_SIGNATURE_FAILURE_THRESHOLD=10

# How far custody may sit below user obligations before Job C calls it an
# insolvency signal, in the asset's smallest unit. 0 is correct and is the
# default: the expected shortfall is derived from in-flight postings, not from
# a tuned epsilon. Raise it only to silence a known, understood, temporary
# difference — and lower it back afterwards.
CUSTODY_TOLERANCE_UNITS=0
